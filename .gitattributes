# Auto detect text files and perform LF normalization
* text=auto

# Preserve historical whitespace in compatibility data during diff checks.
# The archive is also excluded from language statistics.
archive/python-legacy/** linguist-vendored linguist-detectable=false -whitespace
rust/config/** -whitespace

# Journal fixtures are embedded byte-for-byte with include_bytes! and their
# records are checksummed, so a CRLF checkout on Windows would change the
# bytes the tests assert on.
rust/fixtures/** text eol=lf

# Frontend sources build into a bundle that is embedded byte-for-byte into
# the Rust binary, and pnpm verifies pnpm-lock.yaml against content hashes,
# so a CRLF checkout on Windows would change build output and lockfile bytes.
frontend/** text=auto eol=lf
