# Rust reads process environment variables and does not load this file itself.
# Copy only the entries you need into a private, ignored `.env`, or export them
# through your process supervisor. Never commit real values.

# Binance credentials are accepted only by explicitly acknowledged Testnet
# commands in the current build. Do not put mainnet credentials here.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Generate a long random value for the loopback Web control plane.
CRYPTO_TRADING_WEB_TOKEN=
