# Rust build artifacts
/target/
/rust/target/
**/*.rs.bk

# JavaScript dependency and build artifacts
/node_modules/
/dist/
/frontend/node_modules/
/frontend/dist/

# Scratch directories a test run can leave behind in the working tree
/rust/temp-*/

# Local orchestration transcripts are reproducible process output. Durable
# decisions and verification evidence belong under docs/ and artifacts/.
/.workflow/

# Python compatibility runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Local credentials and operator state
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key

# Runtime output
logs/
/rust/var/
*.log
*.jsonl.tmp
*.db
*.sqlite*

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# The frozen legacy snapshot must reproduce every blob from its source commit,
# including files that would normally be ignored in active development.
!archive/python-legacy/
!archive/python-legacy/**
